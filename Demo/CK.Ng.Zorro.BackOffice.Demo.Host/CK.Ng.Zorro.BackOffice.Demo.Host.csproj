<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- It's a mess. See https://github.com/dotnet/project-system/issues/3619 -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bootstrap of the host (Program.cs, the Windows service support) and the conventions of the host project. -->
    <PackageReference Include="CK.AppHost" Version="24.0.0-0.cris-auth.1.ci.66" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.Ng.Zorro.BackOffice.Demo.Builder\CK.Ng.Zorro.BackOffice.Demo.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\CK.Ng.Zorro.BackOffice.Demo.App\CK.Ng.Zorro.BackOffice.Demo.App.csproj" />
  </ItemGroup>
</Project>