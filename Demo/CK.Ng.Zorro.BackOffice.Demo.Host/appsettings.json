{
  "AllowedHosts": "*",
  "CK-AppIdentity": {
    "FullName": "Demo/$Host"
    /* This application is its own AuthCenter, and a web server: its "HttpEndpoint" feature*/
    /* (CK.AppIdentity.HttpEndpoint) starts the web application of each endpoint.*/,
    "Local": {
      "AllowFeatures": "AuthCenter, HttpEndpoint"
      /* The "Main" endpoint: the client application and its "/.cris" endpoints share this origin (no CORS).*/,
      "HttpEndpoint": {
        "Main": {
          "Urls": "http://localhost:5001"
        }
      },
      "Client": {
        "App": {}
      }
    },
    "Parties": []
  },
  "CK-Monitoring": {
    "LogPath": "Logs",
    "HandleDotNetLogs": false,
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": {
      "Handlers": {
        "Console": true,
        "TextFile": {
          "Path": "Text"
        }
      }
    }
  }
}
